# Supabase pooled connection string for the app runtime.
# Use the Session pooler URL for a Render web service. If you use the
# Transaction pooler URL, append ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
